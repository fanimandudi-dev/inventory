# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign JWT access tokens (change in production)
JWT_SECRET=change-me-with-a-long-random-string

# Secret used for the HMAC integrity checksum embedded in every QR label
QR_SECRET=change-me-with-another-long-random-string

# Optional
NODE_ENV=development
PORT=3000
